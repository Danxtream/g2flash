+/* H.264 bridge probes. Preserve stock ABI/return values and only count while
+ * an H.264 session is active. The packed counters in telemetry identify the
+ * exact stage at which a completed RIGHT snapshot stops progressing. */
+int h264_bridge_gate_probe(uint32_t module_id) {
+    customCfwContext *ctx = peekCustomCfwContext();
+    if (ctx && ctx->h264_active) ctx->h264_bridge_gate_calls++;
+    return FW_MODULE_GATE(module_id);
+}
+
+int h264_bridge_emit_probe(uint32_t id, void *hdr, int kind, uint32_t p4) {
+    customCfwContext *ctx = peekCustomCfwContext();
+    if (ctx && ctx->h264_active) ctx->h264_bridge_emit_calls++;
+    return FW_COMPLETE_EMIT(id, hdr, kind, p4);
+}
+
+int h264_bridge_schedule_probe(uint32_t module_id, void *payload, uint32_t len, uint32_t delay_ms) {
+    customCfwContext *ctx = peekCustomCfwContext();
+    if (ctx && ctx->h264_active) ctx->h264_bridge_schedule_calls++;
+    int r = FW_ASYNC_SCHEDULE(module_id, payload, len, delay_ms);
+    if (ctx && ctx->h264_active && r == 0) ctx->h264_bridge_schedule_ok++;
+    return r;
+}
+
+int h264_bridge_send_probe(uint32_t module_id, void *payload, uint32_t len, uint32_t arg3) {
+    customCfwContext *ctx = peekCustomCfwContext();
+    if (ctx && ctx->h264_active) ctx->h264_bridge_send_calls++;
+    return FW_TRANSPORT_SEND(module_id, payload, len, arg3);
+}
+
+void h264_bridge_op3_probe(void *e0_obj, void *payload, uint32_t len) {
+    customCfwContext *ctx = peekCustomCfwContext();
+    if (ctx && ctx->h264_active) ctx->h264_bridge_op3_calls++;
+    FW_E0_OP3(e0_obj, payload, len);
+}
