+/* V3 probes inside stock dispatcher FUN_00496544. Each replaces an existing BL,
+ * calls the exact stock callee, and returns its value unchanged. This avoids
+ * modifying any compare/branch instruction in the dispatcher. */
+uint32_t h264_dispatch_type11_probe(void) {
+    h264_dispatch_mark(2u, 16u);
+    return FW_DISPATCH_DIAG();
+}
+
+void *h264_dispatch_lookup_probe(void *dispatcher, uint32_t key) {
+    void *r = FW_DISPATCH_LOOKUP(dispatcher, key);
+    uint32_t subtype = r ? (uint32_t)*((uint8_t *)r + 8) : 0xffu;
+    uint32_t detail = (r ? 1u : 0u) | (subtype << 8) | ((key & 0xffffu) << 16);
+    h264_dispatch_mark(3u, detail);
+    return r;
+}
+
+uint32_t h264_dispatch_subtype2_probe(void) {
+    h264_dispatch_mark(4u, 2u);
+    return FW_DISPATCH_DIAG();
+}
+
+uint32_t h264_dispatch_field_mismatch_probe(void) {
+    h264_dispatch_mark(5u, 0x4cu);
+    return FW_DISPATCH_DIAG();
+}
+
+void *h264_dispatch_malloc_probe(uint32_t size) {
+    h264_dispatch_mark(6u, size);
+    void *r = FW_MALLOC(size);
+    h264_dispatch_mark(7u, (r ? 0x80000000u : 0u) | (size & 0x7fffffffu));
+    return r;
+}
+
+void *h264_dispatch_prep2_probe(void *a0, void *a1, void *a2, uint32_t a3) {
